# ==============================================================================
# MOMENT 감성 분석 서비스 - 환경 변수 설정 템플릿 (.env.example)
# ==============================================================================
# 이 파일은 환경 변수의 예시(템플릿)입니다.
# 실제 비밀 키는 이 파일이 아닌 '.env' 파일에 입력해야 하며, '.env'는 절대로 Git에 올리지 않습니다.

# ------------------------------------------------------------------------------
# 1. OpenAI 설정 (필수)
# ------------------------------------------------------------------------------
# OpenAI 대시보드(https://platform.openai.com/api-keys)에서 발급받은 시크릿 키를 입력하세요.
# 예: sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=your_openai_api_key_here

# 감성 분석에 사용할 OpenAI 모델명을 입력하세요.
# 가성비와 속도가 우수한 gpt-4o-mini 또는 gpt-4o 모델을 권장합니다.
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. Supabase 설정 (선택적 저장 기능 사용 시 필요)
# ------------------------------------------------------------------------------
# Supabase 프로젝트 설정(Project Settings -> API)에서 확인할 수 있습니다.
# Project URL 예시: https://abcdefghijklmn.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# 서버 전용 비공개 키 (service_role secret)
# 주의: 이 키는 데이터베이스의 RLS를 우회할 수 있는 강력한 관리자 키입니다.
# 절대로 브라우저(HTML/JS)에 노출되어서는 안 되며 서버리스 백엔드에서만 사용됩니다.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

